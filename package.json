{
  "name": "gild",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "bin": {
    "gild": "src/gild.ts"
  },
  "scripts": {
    "dev": "bun run src/gild.ts",
    "build": "bun build --compile --minify src/gild.ts --outfile dist/gild",
    "test": "bun test",
    "pack": "bun run scripts/pack.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "inquirer": "^12.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bun-types": "^1.3.1",
    "prettier": "3.9.9",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "trustedDependencies": ["node-pty"]
}
