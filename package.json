{
  "name": "gild",
  "version": "0.6.8",
  "private": true,
  "type": "module",
  "bin": {
    "gild": "src/gild.ts"
  },
  "scripts": {
    "dev": "bun run src/gild.ts",
    "build": "bun build --compile --minify src/gild.ts --outfile dist/gild",
    "test": "bun test",
    "test:setup-node:revert": "node scripts/setup-node-revert.mjs",
    "pack": "bun run scripts/pack.mjs",
    "vm:image": "bun run scripts/build-vm-image.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "test:pack": "node scripts/check-packages.mjs",
    "test:install": "node scripts/check-install.mjs",
    "test:installed-pty": "node scripts/test-installed-pty.mjs",
    "test:install:revert": "node scripts/no-install-scripts-revert.mjs"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "inquirer": "^12.9.4",
    "smol-toml": "^1.9.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bun-types": "^1.3.1",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "node-pty": "1.2.0-beta.15"
  }
}
